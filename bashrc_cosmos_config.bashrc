
# ~/.bashrc - Han's Custom COSMOS Mode Config
# 👨‍🔧🌍 Myth.OS Enhancement Layer

# Activate Cosmos Environment
alias environment='source ~/cosmos_venv/bin/activate'

# Quality of Life
alias cls='clear'
alias gs='git status'
alias ga='git add .'
alias gc='git commit -m'
alias gp='git push'
alias py='python3'
alias act='source ~/cosmos_venv/bin/activate'

# Myth.OS Broadcast Ping
echo "🔋🔋✅🌊🔉 Myth.OS CLI Activated - COSMOS Protocol Engaged"
